# In staging environment, is is recommanded to use a different database user and password than in production. This is to ensure that if the staging environment is compromised, the production database remains secure. Also try using strong username and password for security reasons.

POSTGRES_USER=highly_secure_username
POSTGRES_PASSWORD=highly_secure_password
POSTGRES_PORT=port_number # Write port number, if you want to connect to the database from outside the docker network. If you don't want to connect from outside, you can leave it empty.